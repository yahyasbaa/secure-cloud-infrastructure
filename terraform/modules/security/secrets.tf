# Application API token.
#
# The value is generated by an *ephemeral* resource and written through a
# *write-only* attribute: it exists only in memory during apply and is never
# persisted in the Terraform plan or state file. To rotate it through
# Terraform, increment var.app_token_version; scripts/rotate-app-token.sh
# rotates it out-of-band. The application accepts AWSCURRENT and AWSPREVIOUS
# so clients get a grace period after rotation.
#
# Database credentials are NOT created here: RDS manages the master password
# itself (manage_master_user_password) and stores it in Secrets Manager,
# encrypted with the data key and rotated automatically by RDS.

ephemeral "random_password" "app_token" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "app_token" {
  #checkov:skip=CKV2_AWS_57:Rotation is version-driven (app_token_version) or via scripts/rotate-app-token.sh. See security/suppressions.md.
  name                    = "${var.name}/app/api-token"
  description             = "Bearer token required by the ${var.name} API."
  kms_key_id              = aws_kms_key.data.arn
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret_version" "app_token" {
  secret_id                = aws_secretsmanager_secret.app_token.id
  secret_string_wo         = ephemeral.random_password.app_token.result
  secret_string_wo_version = var.app_token_version
}

# Only principals in this account may ever read the secret, regardless of
# what identity policies elsewhere might say.
data "aws_iam_policy_document" "app_token" {
  statement {
    sid       = "DenyOtherAccounts"
    effect    = "Deny"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = ["*"]

    principals {
      type        = "AWS"
      identifiers = ["*"]
    }

    condition {
      test     = "StringNotEquals"
      variable = "aws:PrincipalAccount"
      values   = [var.account_id]
    }
  }
}

resource "aws_secretsmanager_secret_policy" "app_token" {
  secret_arn          = aws_secretsmanager_secret.app_token.arn
  policy              = data.aws_iam_policy_document.app_token.json
  block_public_policy = true
}
